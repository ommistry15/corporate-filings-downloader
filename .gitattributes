# Normalise text files, keep Windows batch/PowerShell scripts CRLF
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch binary assets
*.ico binary
*.png binary
*.ttf binary
*.exe binary
*.zip binary
*.icns binary
# macOS shell scripts must keep LF or they won't run
*.sh text eol=lf
*.command text eol=lf
